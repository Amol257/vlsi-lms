# ==============================================================================
# VLSI LMS : Hostinger Web Server Security Hardening (.htaccess)
# ==============================================================================

# 1. Disable Directory Browsing and Server Signatures
Options -Indexes
ServerSignature Off

# 2. Enforce HTTPS & Block Directory Access
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent HTTPS redirect loops behind Hostinger reverse proxy
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to version control internals with 404 Not Found
    RewriteCond %{REQUEST_URI} (\/\.(git|svn|hg|idea)) [NC]
    RewriteRule ^ - [R=404,L]

    # Block access to system directories with 404 Not Found
    RewriteRule ^(database|tools|docs|scratch|includes|lms_storage|media/incoming|storage|uploads|tests)(\/|$) - [R=404,L,NC]

    # Block access to script files with 404 Not Found
    RewriteRule \.(ps1|sh)$ - [R=404,L,NC]

    # Block direct requests to .json files except under assets/ (e.g. webmanifest)
    RewriteCond %{REQUEST_URI} !^/assets/
    RewriteRule \.json$ - [F,L,NC]
</IfModule>

# 3. Deny Direct Web Access to Sensitive Files and Extensions
<FilesMatch "(^config.*\.php$|\.sql$|\.md$|^\.git|\.env|\.log$|\.ps1$|\.sh$|\.bak$|\.old$|\.orig$|\.zip$|\.rar$|\.7z$|\.tar$|\.gz$|\.ini$|\.lock$|composer\.(json|lock)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Security Headers & Strict Content Security Policy (CSP)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header unset X-Powered-By
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://riipijrgucqigndcjwre.supabase.co https://api.razorpay.com https://lumberjack.razorpay.com; frame-src 'self' https://meet.google.com https://api.razorpay.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://riipijrgucqigndcjwre.supabase.co;"
</IfModule>
